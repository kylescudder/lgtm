<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by MSAL for its token cache. Prefixed with the team id at
         runtime to match the keychainSharingGroup MSAL is configured with.
         Add the Push Notifications capability (aps-environment) here once APNs
         is set up in Phase 0. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.microsoft.adalcache</string>
    </array>
</dict>
</plist>
